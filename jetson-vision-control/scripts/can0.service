# Install:
#   sudo cp can0.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now can0.service

[Unit]
Description=Bring up can0 at 125 kbit/s
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/sbin/ip link set can0 down
ExecStart=/sbin/ip link set can0 type can bitrate 125000 sample-point 0.875 sjw 16 restart-ms 100
ExecStart=/sbin/ip link set can0 up
ExecStop=/sbin/ip link set can0 down

[Install]
WantedBy=multi-user.target
